APP_LOCALE=en
GOOGLE_HEALTH_CLIENT_SECRETS=data/google-client-secret.json
GOOGLE_HEALTH_TOKEN_PATH=data/google-health-token.json
GOOGLE_HEALTH_SCOPES=activity_and_fitness,health_metrics_and_measurements,sleep,profile
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_ID=replace-with-your-chat-id
DATABASE_URL=sqlite:///data/app.db
RAW_DATA_DIR=data/raw-google-health
FOOD_PHOTO_DIR=data/food-photos
FATSECRET_REPORT_DIR=data/fatsecret-reports
# OAuth 1.0 credentials from FatSecret Platform → API Keys. Never commit real values.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# The bot imports the current FatSecret diary at this local time after one-time linking.
FATSECRET_AUTO_IMPORT_TIME=23:30
OBSIDIAN_VAULT=C:\\Path\\To\\ObsidianVault
TIMEZONE=Europe/Kiev
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=1
# Production routing: detailed reports use Opus, interactive questions use Sonnet.
CLAUDE_REPORT_MODEL=claude-opus-5
CLAUDE_QUESTION_MODEL=claude-sonnet-5
CLAUDE_INPUT_PRICE_PER_MILLION_USD=2
CLAUDE_OUTPUT_PRICE_PER_MILLION_USD=10
CLAUDE_CACHE_READ_PRICE_PER_MILLION_USD=0.20
CLAUDE_CACHE_CREATION_PRICE_PER_MILLION_USD=2.50
CLAUDE_REPORT_INPUT_PRICE_PER_MILLION_USD=5
CLAUDE_REPORT_OUTPUT_PRICE_PER_MILLION_USD=25
CLAUDE_REPORT_CACHE_READ_PRICE_PER_MILLION_USD=0.50
CLAUDE_REPORT_CACHE_CREATION_PRICE_PER_MILLION_USD=6.25
CLAUDE_QUESTION_INPUT_PRICE_PER_MILLION_USD=2
CLAUDE_QUESTION_OUTPUT_PRICE_PER_MILLION_USD=10
CLAUDE_QUESTION_CACHE_READ_PRICE_PER_MILLION_USD=0.20
CLAUDE_QUESTION_CACHE_CREATION_PRICE_PER_MILLION_USD=2.50
SYNC_INTERVAL_MINUTES=240
DAILY_REPORT_TIME=08:00
WEEKLY_REPORT_TIME=08:15
MONTHLY_REPORT_TIME=08:30
BACKUP_TIME=03:00
WEEKLY_REPORT_WEEKDAY=0
SCHEDULER_TICK_SECONDS=30
